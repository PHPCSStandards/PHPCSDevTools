#!/usr/bin/env php
<?php

/**
 * PHPCSDevTools, tools for PHP_CodeSniffer sniff developers.
 *
 * @package   PHPCSDevTools
 * @copyright 2019 PHPCSDevTools Contributors
 * @license   https://opensource.org/licenses/LGPL-3.0 LGPL3
 * @link      https://github.com/PHPCSStandards/PHPCSDevTools
 */

use PHPCSDevTools\Scripts\Scaffold\Container;

/**
 * PHPCSDevTools, tools for PHP_CodeSniffer sniff developers.
 *
 * @package PHPCSDevTools
 *
 * @copyright 2019 PHPCSDevTools Contributors
 * @license   https://opensource.org/licenses/LGPL-3.0 LGPL3
 *
 * @link https://github.com/PHPCSStandards/PHPCSDevTools
 */
$rootDirectory = \dirname(__DIR__);

if (isset($GLOBALS['_composer_autoload_path']) === true) {
    require $GLOBALS['_composer_autoload_path'];
} else {
    $autoloadPath = \implode(\DIRECTORY_SEPARATOR, [$rootDirectory, 'vendor', 'autoload.php']);

    \assert(\is_file($autoloadPath) === true, 'Autoload file not found. Run "composer install" to generate it.');

    require $autoloadPath;
}

$scaffoldConfigPath = \implode(\DIRECTORY_SEPARATOR, [$rootDirectory, 'config', 'scaffold']);
if (\is_dir($scaffoldConfigPath) === false) {
    throw new \RuntimeException('Scaffold configuration directory not found: ' . $scaffoldConfigPath);
}

$aliases   = require $scaffoldConfigPath . \DIRECTORY_SEPARATOR . 'aliases.php';
$factories = require $scaffoldConfigPath . \DIRECTORY_SEPARATOR . 'factories.php';
$services  = require $scaffoldConfigPath . \DIRECTORY_SEPARATOR . 'services.php';

$container = new Container($aliases, $factories, $services);

$application = $container->get('PHPCSDevTools\\Scripts\\Scaffold\\Console\\ApplicationInterface');

$application->run(
    $container->get('PHPCSDevTools\\Scripts\\Scaffold\\Console\\RequestInterface'),
    $container->get('PHPCSDevTools\\Scripts\\Scaffold\\WorkspaceInterface')
);
