#!/usr/bin/env php
<?php

/**
 * PHPCSDevTools, tools for PHP_CodeSniffer sniff developers.
 *
 * @package   PHPCSDevTools
 * @copyright 2019 PHPCSDevTools Contributors
 * @license   https://opensource.org/licenses/LGPL-3.0 LGPL3
 * @link      https://github.com/PHPCSStandards/PHPCSDevTools
 */

use PHPCSDevTools\Scripts\Scaffold\Exception\ScaffolderException;
use PHPCSDevTools\Scripts\Scaffold\FileCreator;
use PHPCSDevTools\Scripts\Scaffold\FileReader;
use PHPCSDevTools\Scripts\Scaffold\Generator\DocsGenerator;
use PHPCSDevTools\Scripts\Scaffold\Generator\SniffGenerator;
use PHPCSDevTools\Scripts\Scaffold\Generator\UnitTestGenerator;
use PHPCSDevTools\Scripts\Scaffold\Generator\UnitTestIncFixedGenerator;
use PHPCSDevTools\Scripts\Scaffold\Generator\UnitTestIncGenerator;
use PHPCSDevTools\Scripts\Scaffold\Resolver\FullyQualifiedClassResolver\SniffFullyQualifiedClassResolver;
use PHPCSDevTools\Scripts\Scaffold\Resolver\FullyQualifiedClassResolver\UnitTestFullyQualifiedClassResolver;
use PHPCSDevTools\Scripts\Scaffold\Resolver\NamespaceResolver\SniffNamespaceResolver;
use PHPCSDevTools\Scripts\Scaffold\Resolver\NamespaceResolver\UnitTestNamespaceResolver;
use PHPCSDevTools\Scripts\Scaffold\Resolver\PathResolver\DocsPathResolver;
use PHPCSDevTools\Scripts\Scaffold\Resolver\PathResolver\SniffPathResolver;
use PHPCSDevTools\Scripts\Scaffold\Resolver\PathResolver\UnitTestIncFixedPathResolver;
use PHPCSDevTools\Scripts\Scaffold\Resolver\PathResolver\UnitTestIncPathResolver;
use PHPCSDevTools\Scripts\Scaffold\Resolver\PathResolver\UnitTestPathResolver;
use PHPCSDevTools\Scripts\Scaffold\Resolver\ShortClassResolver\SniffShortClassResolver;
use PHPCSDevTools\Scripts\Scaffold\Resolver\ShortClassResolver\UnitTestShortClassResolver;
use PHPCSDevTools\Scripts\Scaffold\Scaffolder;
use PHPCSDevTools\Scripts\Scaffold\SniffName;
use PHPCSDevTools\Scripts\Scaffold\TemplateRenderer;
use PHPCSDevTools\Scripts\Scaffold\Workspace;
use PHPCSDevTools\Scripts\Utils\CliWriter;

$autoloadLocations = [
    __DIR__ . '/../devtools-autoload.php', // Git clone or direct run from within vendor package directory.
    __DIR__ . '/../phpcsstandards/phpcsdevtools/devtools-autoload.php', // Composer bin dir install.
    __DIR__ . '/../autoload.php', // Try Composer autoload from a bin dir install.
    __DIR__ . '/../../../autoload.php', // Try Composer autoload from within vendor package directory.
    __DIR__ . '/../vendor/autoload.php', // Try Composer autoload from a git clone install.
];

// Try and find a usable autoload file.
foreach ($autoloadLocations as $file) {
    $file = \realpath($file);
    if ($file !== false && \is_file($file) === true) {
        require_once $file;

        break;
    }
}

$writer = new CliWriter();

$fileReader  = new FileReader();
$fileCreator = new FileCreator();

$docsPathResolver             = new DocsPathResolver();
$sniffPathResolver            = new SniffPathResolver();
$unitTestIncFixedPathResolver = new UnitTestIncFixedPathResolver();
$unitTestIncPathResolver      = new UnitTestIncPathResolver();
$unitTestPathResolver         = new UnitTestPathResolver();

$sniffNamespaceResolver    = new SniffNamespaceResolver();
$unitTestNamespaceResolver = new UnitTestNamespaceResolver();

$sniffShortClassResolver    = new SniffShortClassResolver();
$unitTestShortClassResolver = new UnitTestShortClassResolver();

$sniffFullyQualifiedClassResolver    = new SniffFullyQualifiedClassResolver();
$unitTestFullyQualifiedClassResolver = new UnitTestFullyQualifiedClassResolver();

$templateRenderer = new TemplateRenderer($fileReader);

$docsGenerator             = new DocsGenerator($docsPathResolver, $fileCreator, $templateRenderer, $writer);
$sniffGenerator            = new SniffGenerator(
    $fileCreator,
    $sniffNamespaceResolver,
    $sniffPathResolver,
    $sniffShortClassResolver,
    $templateRenderer,
    $writer
);
$unitTestGenerator         = new UnitTestGenerator(
    $fileCreator,
    $sniffFullyQualifiedClassResolver,
    $templateRenderer,
    $unitTestFullyQualifiedClassResolver,
    $unitTestNamespaceResolver,
    $unitTestPathResolver,
    $unitTestShortClassResolver,
    $writer
);
$unitTestIncGenerator      = new UnitTestIncGenerator(
    $fileCreator,
    $templateRenderer,
    $unitTestIncPathResolver,
    $writer
);
$unitTestIncFixedGenerator = new UnitTestIncFixedGenerator(
    $fileCreator,
    $templateRenderer,
    $unitTestIncFixedPathResolver,
    $writer
);

$scaffolder = new Scaffolder(
    $docsGenerator,
    $sniffGenerator,
    $templateRenderer,
    $unitTestGenerator,
    $unitTestIncFixedGenerator,
    $unitTestIncGenerator,
    $writer
);

if (\count($argv) !== 2 || \in_array($argv[1], ['-h', '--help'], true)) {
    $scaffolder->printHelp();
}

try {
    $sniffName = SniffName::fromString($argv[1]);
    $workspace = Workspace::fromCurrentWorkingDirectory();

    $scaffolder->scaffold($sniffName, $workspace);

    exit(0);
} catch (ScaffolderException $throwable) {
    $writer->toStderr(\sprintf(
        'Error: %s%s%s',
        $throwable->getMessage(),
        \PHP_EOL . \PHP_EOL,
        $throwable->getTraceAsString()
    ));

    exit(1);
}
